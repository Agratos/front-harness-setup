{
	"name": "harness-setup",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix --cache",
		"fix": "yarn lint:fix && yarn format",
		"format": "prettier \"**/*.{ts,tsx,js,jsx,css,md,json}\" --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"check:arch": "node scripts/check-arch.js",
		"reset": "node scripts/reset-project.mjs",
		"copy": "node scripts/copy-project.mjs",
		"notion:flush": "node scripts/notion-flush.mjs"
	},
	"dependencies": {
		"@mantine/core": "^8.2.7",
		"@mantine/form": "^8.2.7",
		"@mantine/hooks": "^8.2.7",
		"@tanstack/react-query": "^5.101.0",
		"axios": "^1.17.0",
		"mantine-form-zod-resolver": "^1.3.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^7.17.0",
		"zod": "^4.1.4",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@playwright/test": "^1.60.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.3.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@typescript-eslint/parser": "^8.41.0",
		"@vitejs/plugin-react": "^5.0.0",
		"babel-plugin-react-compiler": "^19.1.0-rc.3",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^6.0.0-rc.1",
		"eslint-plugin-react-refresh": "^0.4.20",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^16.3.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.6.2",
		"tsx": "^4.19.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.1",
		"typescript-transform-paths": "^3.5.5",
		"vite": "^7.1.2",
		"vite-plugin-svgr": "^4.5.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	},
	"packageManager": "yarn@4.9.4"
}
